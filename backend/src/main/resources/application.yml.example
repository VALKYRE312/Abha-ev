# ABHA Enterprise Backend Configuration Example
# Copy this file to application.yml and update with your values

spring:
  datasource:
    url: jdbc:postgresql://your-neon-host.neon.tech/abha_enterprise?sslmode=require
    username: your_database_username
    password: your_database_password

firebase:
  credentials:
    file-path: ./firebase-service-account.json
  project-id: your-firebase-project-id

app:
  cors:
    allowed-origins: http://localhost:3000,https://yourdomain.com
  
  cloudinary:
    cloud-name: your_cloudinary_cloud_name
    api-key: your_cloudinary_api_key
    api-secret: your_cloudinary_api_secret
