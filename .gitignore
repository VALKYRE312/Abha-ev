# ABHA Enterprise - Git Ignore

# Environment variables
.env
.env.local
.env.*.local
*.env

# Secrets and credentials
**/firebase-service-account*.json
**/credentials*.json
**/*-credentials.json

# IDE
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store

# Backend (Java/Maven/Spring Boot)
backend/target/
backend/.mvn/
backend/mvnw
backend/mvnw.cmd
backend/HELP.md
backend/**/*.class
backend/**/*.jar
backend/**/*.war
backend/**/*.ear
backend/**/*.log
backend/**/*.logs
backend/.settings/
backend/.project
backend/.classpath
backend/bin/

# Frontend (Next.js/Node)
frontend/node_modules/
frontend/.next/
frontend/out/
frontend/dist/
frontend/build/
frontend/.turbo/
frontend/*.tsbuildinfo
frontend/.vercel

# Logs
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Testing
coverage/
*.coverage
.nyc_output/
junit.xml

# Temporary files
*.tmp
*.temp
.cache/
tmp/

# OS
Thumbs.db
.DS_Store
desktop.ini

# Database
*.db
*.sqlite
*.sql.backup

# Documentation builds (keep source)
documentation/**/*.pdf
documentation/**/*.html

# Keep documentation source
!documentation/**/*.md

# IDE and runtime caches
.cache/
.codeium/
.kilo/worktrees/
